MicroMultiplier: {
	Label: Microbiomes
	Tooltip:
		'''
		Multiplies the amount of Microbiomes (Minecart tracks, Sword Shrines and more)
		that appear throughout the world.
		'''
}

OceanCaves: {
	Label: Guaranteed Ocean Caves
	Tooltip: Guarantees that an Ocean Cave generates in one of the oceans. (From Drunk Seed)
}

SurfaceTemple: {
	Label: Surface Temple
	Tooltip: Generates the Temple at the surface instead of underground. (From Remix Seed)
}

EvilSurface: {
	Label: Evil Surface
	Tooltip: Covers the entire surface in Corruption or Crimson biome. (From Remix Seed)
}

NoTraps: {
	Label: '''"No" Traps'''
	Tooltip: Drastically increases the amount of traps throughout the world. (From No Traps seed)
}

MushroomLayer: {
	Label: Mushroom Layer
	Tooltip: Generates a layer of the Glowing Mushroom Biome above the Underworld. (From Remix Seed)
}

RainbowCabins: {
	Label: Rainbow Cabins
	Tooltip: Paints underground cabins Rainbow with either paint or Rainbow Bricks. (From CelebrationMK10 Seed)
}

PaintEverything: {
	Label: Paint Everything
	Tooltip: Paints everything. (From CelebrationMK10 Seed)
}

MahoganyTrees: {
	Label: Mahogany Anywhere
	Tooltip: Living Mahogany Trees can spawn anywhere throughout the surface. (From Drunk Seed)
}

UndergroundDungeon: {
	Label: Underground Dungeon
	Tooltip:
		'''
		Generates the Dungeon to be accessed through a decayed Living Tree,
		rather than being on the surface. (From Drunk Seed)
		'''
}

MarbleGraniteSwapped: {
	Label: Marble/Granite Swapped
	Tooltip: Swaps the positions and shapes of Marble and Granite biomes. (From Drunk Seed)
}
