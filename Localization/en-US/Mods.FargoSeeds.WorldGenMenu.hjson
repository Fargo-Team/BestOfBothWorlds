FishingShacks: {
	Label: Fishing Shacks
	Tooltip: Adds new fishing shack structures throughout the underground.
}

Mineshafts: {
	Label: Ravines
	Tooltip: Adds new ravine structures throughout the underground.
}

GrandCaverns: {
	Label: Grand Caverns
	Tooltip: Adds new grand cavern structures throughout the underground. Great for farming and fighting!
}

Graveyard: {
	Label: Graveyard
	Tooltip: Adds a new graveyard structure somewhere on the surface.
}

BothEvils: {
	Label: Both Evils
	Tooltip: Generates both the Corruption and Crimson in the same world, on opposite sides. (From Drunk Seed)
}

BothOres: {
	Label: Both Ores
	Tooltip: Generates both ore sets during world creation and altar smashing. (From Drunk Seed)
}

WavyCaves: {
	Label: Cave Overhaul
	Tooltip:
		'''
		Caves have more openings and long-winded paths. 
		Less digging, more exploring! (The Constant Seed)
		'''
}

RemixUnderworld: {
	Label: Underworld Overhaul
	Tooltip:
		'''
		Generates a large Ashwood Forest in the middle and moves obsidian houses to the outskirts.
		Well suited for fighting the Wall of Flesh! (From Remix Seed)
		'''
}

LivingTrees: {
	Label: More Living Trees
	Tooltip: Generates more Living Trees throughout the world.
}

SurfaceMushroom: {
	Label: Surface Mushroom
	Tooltip: Generates a small Glowing Mushroom biome somewhere on the surface.
}

SurfaceMarble: {
	Label: Surface Marble
	Tooltip: Generates a few Marble patches with statues on or near the surface. (From The Constant Seed)
}

SurfaceSpiders: {
	Label: Surface Spider
	Tooltip: Generates small Spider Nests somewhere on the surface. (From The Constant Seed)
}

BigHives: {
	Label: Big Bee Hives
	Tooltip: Drastically increases the size of Bee Hives. (From Drunk Seed)
}

PyramidEntrance: {
	Label: Guaranteed Pyramid
	Tooltip: Guarantees that a Pyramid generates at the entrance of the Underground Desert.
}

HugeTemple: {
	Label: Huge Jungle Temple
	Tooltip: Drastically increases the size of the Jungle Temple.
}

SecondShimmer: {
	Label: Two Shimmers
	Tooltip: Generates a second Shimmer biome on the opposite side of the world.
}

MarbleMultiplier: {
	Label: Marble
	Tooltip: Multiplies the amount of Marble biomes that appear throughout the world.
}

